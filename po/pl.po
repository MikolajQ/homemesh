msgid "About"
msgstr "O programie"

#: homemesh/gui.py:675
msgid "Menu"
msgstr "Menu"

#: homemesh/gui.py:682 homemesh/gui.py:1241
msgid "Sharing"
msgstr "Udostępnianie"

#: homemesh/gui.py:696
msgid "What other computers see"
msgstr "Co widzą inne komputery"

#: homemesh/gui.py:701
msgid "Change…"
msgstr "Zmień…"

