msgstr "O programie"

#: homemesh/gui.py:770
msgid "Menu"
msgstr "Menu"

#: homemesh/gui.py:777 homemesh/gui.py:1433
msgid "Sharing"
msgstr "Udostępnianie"

#: homemesh/gui.py:791
msgid "What other computers see"
msgstr "Co widzą inne komputery"

#: homemesh/gui.py:796
