<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>HomeMesh</vendor>
  <vendor_url>https://github.com/MikolajQ/homemesh</vendor_url>
  <action id="io.github.MikolajQ.HomeMesh.helper">
    <description>Change home folder sharing and access from away</description>
    <description xml:lang="pl">Zmiana udostępniania katalogu domowego i dostępu spoza domu</description>
    <message>Authentication is required to change home folder sharing or access from away on this computer</message>
    <message xml:lang="pl">Zmiana udostępniania katalogu domowego lub dostępu spoza domu na tym komputerze wymaga hasła administratora</message>
    <icon_name>io.github.MikolajQ.HomeMesh</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/homemesh/homemesh-helper</annotate>
  </action>
</policyconfig>
