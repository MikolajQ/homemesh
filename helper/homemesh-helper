def tool(name):
    """Full path of a program (under ROOT when testing)."""
    for directory in BIN_DIRS:
        path = P(f"{directory}/{name}")
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None if TEST else shutil.which(name)


def real_path(path):
    """A path as the running system sees it (differs from ours only in tests)."""
    return "/" + os.path.relpath(path, ROOT)


def last_line(text):
    lines = [line.strip() for line in (text or "").splitlines() if line.strip()]
    return lines[-1] if lines else ""


def package_manager():
    if TEST:
        forced = os.environ.get("HOMEMESH_HELPER_PM", "none")
        return next((item for item in PACKAGE_MANAGERS if item[0] == forced), None)
    return next((item for item in PACKAGE_MANAGERS if shutil.which(item[0])), None)


def fetch(url, limit):
    import urllib.request
    with urllib.request.urlopen(url, timeout=60) as response:
        data = response.read(limit + 1)
    if len(data) > limit:
        raise ValueError(f"{url}: too large")
    return data


def install_static_tailscale():
    """Tailscale's own build into /usr/local/bin, checked against its sha256.
    Returns the version."""
    import hashlib
    import io
    import platform
    arch = TAILSCALE_ARCHES.get(platform.machine())
    if not arch:
        raise RuntimeError(f"no Tailscale build for {platform.machine()}")
    base = os.environ.get("HOMEMESH_HELPER_TAILSCALE_URL", TAILSCALE_PACKAGES) if TEST else TAILSCALE_PACKAGES
    index = json.loads(fetch(base + "?mode=json", 1 << 20))
    name = index["Tarballs"][arch]
    if not re.match(r"tailscale_[0-9.]+_[a-z0-9]+\.tgz\Z", name):
        raise ValueError(f"unexpected file name {name!r}")
    archive = fetch(base + name, 300 << 20)
    expected = fetch(base + name + ".sha256", 1024).decode("ascii", "replace").split()
    if not expected or hashlib.sha256(archive).hexdigest() != expected[0].lower():
        raise ValueError(f"{name}: checksum does not match")
    with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
        members = {os.path.basename(m.name): m for m in tar.getmembers() if m.isfile()}
        for program in ("tailscale", "tailscaled"):
            if program not in members:
                raise ValueError(f"{name}: no {program} inside")
            write(f"/usr/local/bin/{program}", tar.extractfile(members[program]).read(), 0o755)
    return name.split("_")[1]


def install_tailscale():
    if tool("tailscale") and tool("tailscaled"):
        step("install", True, N_("Tailscale is already installed."))
        return True
    problems = []
    manager = package_manager()
    if manager:
        name, command = manager
        done = run(*command, env=dict(os.environ, DEBIAN_FRONTEND="noninteractive"), timeout=900)
        if done.returncode == 0 and tool("tailscale") and tool("tailscaled"):
            step("install", True, N_("Installed Tailscale with {tool}."), tool=name)
            return True
        problems.append(f"{name}: {last_line(done.stderr) or last_line(done.stdout) or done.returncode}")
    try:  # not in this distribution's repositories, or the package manager is busy
        version = install_static_tailscale()
    except (OSError, ValueError, KeyError, RuntimeError, tarfile.TarError) as error:
        problems.append(f"tailscale.com: {error}")
        step("install", False, N_("Could not install Tailscale: {error}"), error="; ".join(problems))
        return False
    step("install", True, N_("Installed Tailscale {version} from tailscale.com."), version=version)
    return True


def tailscale_service(init, daemon):
    """The name of tailscaled's service, written first if the package has none
    for this init system; None for an unknown init system."""
    for name in ("tailscaled", "tailscale"):  # Alpine calls it tailscale
        if init.installed(name):
            return name
    daemon = real_path(daemon)
    command = f"{daemon} {TAILSCALED_ARGS}"
    if init.kind == "systemd":
        write("/etc/systemd/system/tailscaled.service", SYSTEMD_UNIT.format(command=command, daemon=daemon))
        run("systemctl", "daemon-reload")
    elif init.kind == "openrc":
        write("/etc/init.d/tailscaled", OPENRC_SCRIPT.format(daemon=daemon, args=TAILSCALED_ARGS), 0o755)
    elif init.kind == "runit":
        sv = init.runit_dirs()[0]
        write(f"{sv}/tailscaled/run", RUN_SCRIPT.format(command=command), 0o755)
        write(f"{sv}/tailscaled/finish", FINISH_SCRIPT.format(daemon=daemon), 0o755)
    elif init.kind == "s6":
        write("/etc/s6/sv/tailscaled/type", "longrun\n")
        write("/etc/s6/sv/tailscaled/run", RUN_SCRIPT.format(command=command), 0o755)
        write("/etc/s6/adminsv/default/contents.d/tailscaled", "")
        run("s6-db-reload", check=True)
    elif init.kind == "dinit":
        os.makedirs(P("/var/lib/tailscale"), mode=0o700, exist_ok=True)
        write("/etc/dinit.d/tailscaled", DINIT_SERVICE.format(command=command))
    else:
        return None
    return "tailscaled"


def tailscale_state(cli):
    """BackendState ("NeedsLogin", "Running"…), or None while tailscaled does not answer."""
    done = run(cli, "status", "--json", timeout=10)
    try:
        return json.loads(done.stdout or "null").get("BackendState")
    except (ValueError, AttributeError):
        return None


def start_tailscale(init):
    if init.kind == "unknown":
        step("service", False, N_("Unknown init system. Turn on the tailscaled service by hand."))
        return False
    cli = tool("tailscale")
    try:
        service = tailscale_service(init, tool("tailscaled"))
        if not init.enabled(service):
            init.enable(service)
        if not init.running(service):
            init.start(service)
    except (RuntimeError, OSError) as error:
        step("service", False, N_("Could not start Tailscale: {error}"), error=error)
        return False
    deadline = time.monotonic() + TAILSCALE_WAIT
    while not tailscale_state(cli):
        if time.monotonic() > deadline:
            step("service", False, N_("Tailscale did not start within {seconds} seconds."),
                 seconds=TAILSCALE_WAIT)
            return False
        time.sleep(0.5)
    step("service", True, N_("Tailscale is running and will start with the computer."))
    return True


def allow_operator():
    user = calling_user()
    if user == "root":
        return
    done = run(tool("tailscale"), "set", f"--operator={user}", timeout=30)
    if done.returncode != 0:
        step("operator", False, N_("Could not let {user} control Tailscale: {error}"), user=user,
             error=last_line(done.stderr) or done.returncode)
        return
    step("operator", True, N_("{user} can log in to Tailscale and turn it on and off without the "
                              "administrator password."), user=user)


# ---------------------------------------------------------------- commands

def cmd_enable():
    init = Init()
    state = load_state()
    if configure_sshd():
        start_sshd(init, state)
        open_firewall(state)
        ensure_mdns(init, state)
    state["users"] = sorted(set(state.get("users", [])) | {calling_user()})
    save_state(state)


def cmd_disable():
    init = Init()
    state = load_state()
    users = set(state.get("users", [])) - {calling_user()}
    if users:
        state["users"] = sorted(users)
        save_state(state)
        step("shared", True, N_("Other users of this computer still share their folders, "
                                "so the SSH server stays on."))
        return
    remove(DROPIN)
    sshd = state.pop("sshd", {"enabled": True, "running": True})
    if init.installed("sshd"):
        if not sshd["enabled"]:
            init.disable("sshd")
        if sshd["running"]:
            try:
                init.restart("sshd")  # back to the settings without ours
            except (RuntimeError, OSError):
                pass
        else:
            init.stop("sshd")
    step("sshd", True, N_("The SSH server is back to its settings from before HomeMesh."))
    close_firewall(state)
    revert_mdns(init, state)
    state["users"] = []
    save_state(state)


def cmd_set_hostname(name):
    if not NAME_RE.match(name or ""):
        step("hostname", False, N_("A name may have lowercase letters, digits and hyphens "
                                   "(no hyphen at the start or end)."))
        return
    old = socket.gethostname()
    init = Init()
    if init.kind == "systemd" and shutil.which("hostnamectl") and not TEST:
        done = run("hostnamectl", "set-hostname", name)
        if done.returncode != 0:
            step("hostname", False, "{error}", error=done.stderr.strip())
            return
    else:
        write("/etc/hostname", name + "\n")
        if not TEST:
            run("hostname", name)
    hosts = read("/etc/hosts")
    if old and re.search(rf"\b{re.escape(old)}\b", hosts):
        lines = [re.sub(rf"\b{re.escape(old)}\b", name, line) if not line.lstrip().startswith("#") else line
                 for line in hosts.splitlines()]
        write("/etc/hosts", "\n".join(lines) + "\n")
    if init.installed("avahi-daemon") and init.running("avahi-daemon"):
        init.restart("avahi-daemon")
    step("hostname", True, N_("This computer is now called {name} ({name}.local)."), name=name)


def cmd_tailscale():
    if install_tailscale() and start_tailscale(Init()):
        allow_operator()


def main(argv):
    if os.geteuid() != 0 and not TEST:
        print("homemesh-helper: run as root (pkexec or sudo)", file=sys.stderr)
        return 2
    if len(argv) == 2 and argv[1] == "enable":
        cmd_enable()
    elif len(argv) == 2 and argv[1] == "disable":
        cmd_disable()
    elif len(argv) == 3 and argv[1] == "set-hostname":
        cmd_set_hostname(argv[2])
    elif len(argv) == 2 and argv[1] == "tailscale":
        cmd_tailscale()
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
